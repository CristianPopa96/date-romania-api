# Copy to .env and change the passwords. Every setting the stack reads is here.

POSTGRES_USER=dr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=date_romania

# Local SeaweedFS by default: containers reach it at http://s3:8333, `dr` outside
# Docker at http://127.0.0.1:8333. For another S3 provider, set its endpoint and keys.
# S3_ENDPOINT=https://s3.example.com
S3_BUCKET=raw
S3_ACCESS_KEY=dr
S3_SECRET_KEY=change-me-too
# SeaweedFS ignores the region; set it only for a provider that asks for one.
# S3_REGION=us-east-1

# Sent with every request to a public source, so publishers know who is calling.
# HTTP_USER_AGENT=date-romania/0.1 (+https://github.com/CristianPopa96/date-romania-api)

# For running `dr` or the tests outside Docker. 127.0.0.1, not localhost: the ports
# are published on IPv4 only, and on Windows localhost tries IPv6 first and stalls.
DATABASE_URL=postgresql+psycopg://dr:change-me@127.0.0.1:5432/date_romania

# Image tags to run, and where a local checkout of the site lives.
API_TAG=latest
WEB_TAG=latest
WEB_DIR=../date-romania-web
