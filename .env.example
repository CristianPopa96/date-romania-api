# Copy to .env and change the passwords. Every setting the stack reads is here.

POSTGRES_USER=dr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=date_romania

# Local SeaweedFS by default. For another S3 provider, set its endpoint and keys.
S3_ENDPOINT=http://s3:8333
S3_BUCKET=raw
S3_ACCESS_KEY=dr
S3_SECRET_KEY=change-me-too

# For running `dr` or the tests outside Docker.
DATABASE_URL=postgresql+psycopg://dr:change-me@localhost:5432/date_romania

# Image tags to run, and where a local checkout of the site lives.
API_TAG=latest
WEB_TAG=latest
WEB_DIR=../date-romania-web
